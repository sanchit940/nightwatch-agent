#!/bin/sh
# Install the SSH host key and the authorized key for user nightwatch from /opt/provision.
set -eu
SRC=/opt/provision
install -d -m 0755 /etc/ssh/authorized_keys
install -m 0644 -o root -g root "$SRC/authorized_keys" /etc/ssh/authorized_keys/nightwatch
install -m 0600 -o root -g root "$SRC/ssh_host_ed25519_key" /etc/ssh/ssh_host_ed25519_key
ssh-keygen -y -f /etc/ssh/ssh_host_ed25519_key > /etc/ssh/ssh_host_ed25519_key.pub
chmod 0644 /etc/ssh/ssh_host_ed25519_key.pub
