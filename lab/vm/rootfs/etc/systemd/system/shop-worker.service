[Unit]
Description=Shop order worker
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=shop
Group=shop
ExecStart=/usr/local/bin/shop-worker
StateDirectory=shop-worker
SyslogIdentifier=shop-worker
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
