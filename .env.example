# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
NEATLOGS_API_KEY=
# Model for the agent. Builder choice: Claude Opus 4.8.
NIGHTWATCH_MODEL=claude-opus-4-8
NIGHTWATCH_EFFORT=high
# Secret for approval tokens (HMAC). Generate: python -c "import secrets;print(secrets.token_hex(32))"
NIGHTWATCH_APPROVAL_SECRET=
# Optional: Prometheus in the lab
PROMETHEUS_URL=http://localhost:9090
