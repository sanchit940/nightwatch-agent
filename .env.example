# Copy to .env and fill in. Never commit .env.
# Either a direct Anthropic key, or the neatHack LiteLLM key (then also set NIGHTWATCH_LLM_BASE_URL).
ANTHROPIC_API_KEY=
NIGHTWATCH_LLM_BASE_URL=
NEATLOGS_API_KEY=
# Model for the agent. Direct API: claude-opus-4-8. neatHack proxy: claude-opus-4.6 or claude-sonnet-4.6.
NIGHTWATCH_MODEL=claude-opus-4.6
NIGHTWATCH_EFFORT=high
# Secret for approval tokens (HMAC). Generate: python -c "import secrets;print(secrets.token_hex(32))"
NIGHTWATCH_APPROVAL_SECRET=
# Optional: Prometheus in the lab
PROMETHEUS_URL=http://localhost:9090

# Slack (optional). Without SLACK_BOT_TOKEN, --approval slack runs as a dry run (runs/slack-outbox.jsonl).
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Grafana + Loki (lab defaults). Use a Grafana service-account token in production (GRAFANA_TOKEN).
GRAFANA_URL=http://localhost:3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=
LOKI_URL=http://localhost:3100
# neatlogs read API (not the ingest key): service-account token + project UUID
NEATLOGS_READ_TOKEN=
NEATLOGS_PROJECT_ID=
# AWS read-only: a dedicated profile; the default profile is never used. Optional account pin.
NIGHTWATCH_AWS_PROFILE=
NIGHTWATCH_AWS_REGION=
NIGHTWATCH_AWS_ACCOUNT=

# CI/CD (optional; set only the providers you use)
# NIGHTWATCH_GITHUB_TOKEN=     # fine-grained, actions:read (actions:write for re-runs)
# GITLAB_URL=https://gitlab.com
# GITLAB_TOKEN=                # read_api (api for retries)
# JENKINS_URL=https://jenkins.example.com
# JENKINS_USER=                # Jenkins user ID (with Okta login too)
# JENKINS_TOKEN=               # Jenkins API token (JENKINS_API_TOKEN also works)
