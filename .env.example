# Copy to .env and fill in. Never commit .env.
# Either a direct Anthropic key, or the neatHack LiteLLM key (then also set NIGHTWATCH_LLM_BASE_URL).
ANTHROPIC_API_KEY=
NIGHTWATCH_LLM_BASE_URL=
NEATLOGS_API_KEY=
# Model for the agent. Direct API: claude-opus-4-8. neatHack proxy: claude-opus-4.6 or claude-sonnet-4.6.
NIGHTWATCH_MODEL=claude-opus-4.6
NIGHTWATCH_EFFORT=high
# Secret for approval tokens (HMAC). Generate: python -c "import secrets;print(secrets.token_hex(32))"
NIGHTWATCH_APPROVAL_SECRET=
# Optional: Prometheus in the lab
PROMETHEUS_URL=http://localhost:9090

# Slack (optional). Without SLACK_BOT_TOKEN, --approval slack runs as a dry run (runs/slack-outbox.jsonl).
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
