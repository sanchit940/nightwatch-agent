# NightWatch in your own cloud. Copy to deploy/.env. Never commit .env.
# Comments must be on their own line (docker --env-file does not remove comments at the end of a line).

# Your own Anthropic key (bring your own key). Model: claude-sonnet-5-5, or claude-haiku-5-5 for a lower cost.
ANTHROPIC_API_KEY=
NIGHTWATCH_MODEL=claude-sonnet-5-5
NIGHTWATCH_PROMPT=v6
# Signs approvals. Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
NIGHTWATCH_APPROVAL_SECRET=

# AWS: the instance role (EC2), task role (ECS) or service-account role (EKS). The account pin is required:
# any other account is refused.
NIGHTWATCH_AWS_CREDENTIALS=role
NIGHTWATCH_AWS_ACCOUNT=
NIGHTWATCH_AWS_REGION=us-east-1
# Mask account IDs, public IPs, user names and e-mails before the model sees them (1 = on).
NIGHTWATCH_AWS_MASK=1

# Slack (optional). Without it, plans go to /data/slack-outbox.jsonl and you decide with the CLI.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Optional: neatlogs traces of every model call, tool call and policy decision.
NEATLOGS_API_KEY=

# Optional connectors (remove the # to use them):
# GRAFANA_URL=
# GRAFANA_TOKEN=
# LOKI_URL=
# NIGHTWATCH_GITHUB_TOKEN=
# GITLAB_URL=
# GITLAB_TOKEN=
# JENKINS_URL=
# JENKINS_USER=
# JENKINS_TOKEN=
